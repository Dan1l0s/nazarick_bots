# systemd unit for the bot supervisor - starts the bots on boot and restarts
# them if the supervisor itself ever dies.
#
# Install with:   bash hosting/setup_cicd.sh --install-service
# or by hand:
#   sudo cp hosting/nazarick.service /etc/systemd/system/
#   sudo nano /etc/systemd/system/nazarick.service   # fix User/paths/port
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nazarick
#
# The unit supervises hosting/server_manager.py, NOT main.py directly. The
# manager owns starting and stopping the bots, so systemd starting main.py too
# would give you two competing supervisors. `-r` tells the manager to launch the
# bots as soon as it comes up.

[Unit]
Description=Nazarick Discord bots supervisor
Documentation=https://github.com/Dan1l0s/nazarick_bots
# Wants network rather than Requires: the bots retry their Discord connection
# on their own, so a slow network at boot should not fail the unit.
Wants=network-online.target
After=network-online.target

# Don't let a crash-loop hammer Discord's API: more than 5 restarts in 5
# minutes and systemd gives up until someone intervenes.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

# --- placeholders: setup_cicd.sh rewrites all three ------------------------
# `bash hosting/setup_cicd.sh --install-service` substitutes the real user, the
# repository's actual location (computed from the script's own path) and the
# port from private_config.py before installing the unit, so the values below
# are never used as-is. Replace /path/to/nazarick by hand ONLY if you install
# this file yourself with `sudo cp`.
User=root
WorkingDirectory=/path/to/nazarick/hosting
ExecStart=/usr/bin/python3 /path/to/nazarick/hosting/server_manager.py 10000 -r
# ---------------------------------------------------------------------------

# The supervisor spawns main.py as a child. KillMode=control-group (the default)
# ensures a stop or restart takes the bots down with it, rather than orphaning
# them to hold the voice connections and the sqlite files open.
KillMode=control-group
TimeoutStopSec=30

# Restart on any unclean exit, including the `update` path where the manager
# deliberately re-execs itself.
Restart=always
RestartSec=10

# server_manager.py redirects its own stdout/stderr into logs/<date>.txt, so
# journald would otherwise only capture startup failures. Keeping it connected
# means `systemctl status` shows why a failed start failed.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nazarick

# Unbuffered, so anything that does reach journald appears immediately rather
# than sitting in a pipe buffer during a crash.
Environment=PYTHONUNBUFFERED=1
# Uncomment for verbose logging (also shows routine try_function failures):
#Environment=NAZARICK_LOG_LEVEL=DEBUG

# Conservative sandboxing. The service still has network access and may write
# inside /srv (its checkout, venv, sqlite databases and logs), but it cannot
# gain privileges or alter the host's system configuration.
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
